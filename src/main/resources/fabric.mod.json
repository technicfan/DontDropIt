{
    "schemaVersion": 1,
    "id": "dontdropit",
    "version": "${version}",
    "name": "Don't Drop It!",
    "description": "Prevents accidental dropping of items via various means.",
    "authors": ["ADudeCalledLeo"],
    "contributors": ["technicfan"],
    "contact": {
        "sources": "https://github.com/technicfan/DontDropIt",
        "issues": "https://github.com/technicfan/DontDropIt/issues"
    },
    "license": "MIT",
    "icon": "assets/dontdropit/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": ["adudecalledleo.dontdropit.DontDropIt"],
        "modmenu": ["adudecalledleo.dontdropit.compat.ModMenuSupport"],
        "dontdropit": ["adudecalledleo.dontdropit.DontDropIt"]
    },
    "mixins": ["dontdropit.mixins.json"],
    "accessWidener": "dontdropit.accesswidener",
    "depends": {
